# Copy this file to `.env` (without the .example suffix) and fill in your
# real API key. The real `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#   # edit .env to paste your RUNPOD_API_KEY

# --- RunPod ------------------------------------------------------------------
# Generate at https://console.runpod.io/user/settings → API Keys.
# Needs pod read/write permission. Used by scripts/runpod_launch.py.
RUNPOD_API_KEY=rpa_REPLACE_WITH_YOUR_RUNPOD_API_KEY

# --- (optional) Hugging Face -------------------------------------------------
# Only required if you switch to a gated model (Qwen2.5-1.5B-Instruct is open
# access and does NOT need a token). Useful later if we push a fine-tuned
# model or pull a private dataset.
#
# HF_TOKEN=hf_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN

# --- (optional) pod-side env vars -------------------------------------------
# These are NOT read from .env on your laptop — they're already injected into
# the pod by `scripts/runpod_launch.py` so the remote Python doesn't ping
# telemetry endpoints during the experiment. Listed here just for reference:
#
#   HF_HUB_DISABLE_TELEMETRY=1
#   TOKENIZERS_PARALLELISM=false
